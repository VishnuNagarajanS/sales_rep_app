# Development:
# VITE_APP_ENV=dev
# VITE_API_URL=/api

# Production:
# If frontend & backend share same domain / reverse-proxied (e.g. Nginx):
# VITE_API_URL=/api
# If backend is hosted on a separate domain / subdomain:
# VITE_API_URL=https://api.yourdomain.com/api
VITE_APP_ENV=prod
VITE_API_URL=/api
